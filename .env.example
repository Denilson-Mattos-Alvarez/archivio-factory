# Copiare in .env, escluso da Git. Non inserire credenziali reali nel repository.
ARCHIVIO_AMBIENTE=sviluppo
ARCHIVIO_HOSTS=127.0.0.1,localhost
# In produzione impostare una chiave lunga e casuale, HTTPS e database dedicato.
# ARCHIVIO_SECRET_KEY=
# DATABASE_URL=postgresql://archivio_app:PASSWORD@HOST:5432/postgres?sslmode=require
ARCHIVIO_SCHEMA=archivio_factory
ARCHIVIO_MAX_VIDEO_BYTES=536870912
ARCHIVIO_MAX_ALLEGATO_BYTES=26214400
ARCHIVIO_MAX_PACCHETTO_BYTES=1073741824
ARCHIVIO_MAX_ALLEGATI=20
